<Window x:Class="EnterpriseAIApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Alp Studio — Kurumsal Otonom Masaüstü Ajanı"
        Icon="Assets/app.ico"
        Height="900" Width="1440"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#161618"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Aptos, sans-serif">

    <Window.Resources>
        <!-- Apple macOS Dark Mode Palette -->
        <SolidColorBrush x:Key="BgWindow" Color="#161618"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E1E20"/>
        <SolidColorBrush x:Key="BgCard" Color="#252528"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#2C2C30"/>
        <SolidColorBrush x:Key="BgControl" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="BgControlHover" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="BgControlPressed" Color="#242426"/>

        <SolidColorBrush x:Key="BorderSubtle" Color="#333336"/>
        <SolidColorBrush x:Key="BorderSeparator" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="BorderControl" Color="#38383A"/>
        <SolidColorBrush x:Key="BorderControlHover" Color="#48484A"/>

        <!-- Apple System Blue Accent -->
        <SolidColorBrush x:Key="AccentApple" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentAppleHover" Color="#0071E3"/>
        <SolidColorBrush x:Key="AccentApplePressed" Color="#0062C4"/>

        <!-- Typography -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#636366"/>

        <!-- Apple macOS Dark ScrollBar -->
        <Style x:Key="WindowScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#3E3E42" CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#5A5A60"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#787880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WindowScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WindowScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- APPLE MACOS STANDARD BUTTON STYLE -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource BgControl}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgControlHover}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BorderControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- APPLE MACOS PRIMARY ACCENT BUTTON STYLE -->
        <Style x:Key="ApplePrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource AccentApple}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentApple}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource AccentAppleHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource AccentApplePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- APPLE MACOS DANGER ACCENT BUTTON STYLE -->
        <Style x:Key="AppleDangerButton" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#FF453A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF453A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D73A30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B22A22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- APPLE MACOS COMBOBOX ITEM STYLE -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentApple}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#323236"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- APPLE MACOS COMBOBOX TOGGLE BUTTON -->
        <ControlTemplate x:Key="AppleComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="7" Background="#242426" BorderBrush="#38383A" BorderThickness="1"/>
                <Border Grid.Column="0" CornerRadius="7,0,0,7" Margin="1" Background="Transparent"/>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#86868B"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#48484A"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#F5F5F7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentApple}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentApple}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- APPLE MACOS COMBOBOX STYLE -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource AppleComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,2,24,2" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{StaticResource TextPrimary}" TextElement.FontSize="12"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#252528" BorderBrush="#38383A" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="-90" ShadowDepth="4" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" Background="#252528">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- APPLE MACOS SEGMENTED RADIO BUTTON STYLE -->
        <Style x:Key="AppleSegmentedRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="SegBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="#2A2A2E"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegBorder" Property="Background" Value="#323236"/>
                                <Setter TargetName="SegBorder" Property="BorderBrush" Value="#3E3E42"/>
                                <Setter TargetName="SegBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 1. APPLE UNIFIED HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0" Background="#252528" BorderBrush="#38383A" BorderThickness="1" ClipToBounds="True">
                        <Image Source="Assets/logo_orange.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Alp Studio" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Kurumsal Otonom Masaüstü Ajanı" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tenant & Model Controls (Apple Segmented Style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#242426" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Şirket:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="Medium"/>
                            <ComboBox x:Name="CmbCompanies" Width="230" SelectionChanged="CmbCompanies_SelectionChanged"/>
                            <Button x:Name="BtnNewCompany" Content="+" Click="BtnNewCompany_Click" ToolTip="Yeni Şirket Ekle"
                                    Width="26" Height="26" Margin="6,0,0,0" Padding="0" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#242426" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Model:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="Medium"/>
                            <ComboBox x:Name="CmbModels" Width="220" SelectionChanged="CmbModels_SelectionChanged"/>
                            <Button x:Name="BtnRefreshModels" Content="🔄" Click="BtnRefreshModels_Click" ToolTip="Modelleri ve Ollama Bağlantısını Yenile"
                                    Width="26" Height="26" Margin="6,0,0,0" Padding="0" FontSize="12"/>
                            <Button x:Name="BtnApiKeySettings" Content="🔑" Click="BtnApiKeySettings_Click" ToolTip="🔑 Bulut AI &amp; API Key Ayarları (OpenAI, Claude, Google)"
                                    Width="26" Height="26" Margin="4,0,0,0" Padding="0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Minimal Apple Status Indicator & Fullscreen Chat Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleChatFullscreen" Content="⛶ Tam Ekran Sohbet" Click="BtnToggleChatFullscreen_Click"
                            Padding="12,5" Margin="0,0,10,0" FontSize="11" FontWeight="Medium"
                            ToolTip="Sohbet alanını tam ekrana büyüt veya bölünmüş ekrana geri dön"/>
                    <Border Background="#242426" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusPulseDot" Width="7" Height="7" Fill="#30D158" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtHeaderStatus" Text="AI Hazır" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN SPLIT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftChat" Width="5.5*" MinWidth="350"/>
                <ColumnDefinition x:Name="ColSplitter" Width="1"/>
                <ColumnDefinition x:Name="ColRightGraph" Width="5*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Chat -->
            <Grid Grid.Column="0" Background="{StaticResource BgWindow}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. COMPACT CHAT SESSION BAR -->
                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSeparator}" BorderThickness="0,0,0,1" Padding="12,5">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬 Oturum:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbChatSessions" Width="200" MinHeight="26" FontSize="11" SelectionChanged="CmbChatSessions_SelectionChanged"/>
                            <Button x:Name="BtnNewSession" Content="+ Yeni" Click="BtnNewSession_Click" Padding="9,3" Margin="6,0,0,0" FontSize="11" ToolTip="Yeni bir sohbet oturumu başlat"/>
                            <Button x:Name="BtnRenameSession" Content="✏️" Click="BtnRenameSession_Click" Padding="6,3" Margin="4,0,0,0" FontSize="11" ToolTip="Bu oturumun başlığını değiştir"/>
                            <Button x:Name="BtnDeleteSession" Style="{StaticResource AppleDangerButton}" Content="🗑️" Click="BtnDeleteSession_Click" Padding="6,3" Margin="4,0,0,0" FontSize="11" ToolTip="Bu oturumu sil"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnExportChat" Content="📤 Dışa Aktar ▾" Click="BtnExportChat_Click" Padding="9,3" Margin="0,0,4,0" FontSize="11" ToolTip="Sohbeti veya raporu PDF, Word, HTML veya Markdown olarak dışa aktar"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              AllowDrop="True" Drop="Chat_Drop" DragOver="Chat_DragOver" DragEnter="Chat_DragEnter">
                    <StackPanel x:Name="ChatContainer" Margin="16">
                        <!-- Clean Apple Welcome Card -->
                        <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSeparator}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Alp Asistan" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtCompanyContext" Text="Aktif Şirket: Atlas Yazılım • İzole Çalışma Alanı" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Masaüstü uygulamalarınızı ve kurumsal dokümanlarınızı analiz ederek otonom araçlar üretir ve görevleri yürütür." FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Apple macOS Messages Input Capsule -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,10"
                        AllowDrop="True" Drop="Chat_Drop" DragOver="Chat_DragOver" DragEnter="Chat_DragEnter">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Attached Files / Images Preview Chips -->
                        <WrapPanel x:Name="AttachmentPreviewPanel" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed"/>

                        <TextBox x:Name="TxtPromptInput" Grid.Row="1" 
                                 MinHeight="70" MaxHeight="130"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                 Padding="12,10" FontSize="13"
                                 PreviewKeyDown="TxtPromptInput_PreviewKeyDown"
                                 ToolTip="Mesajınızı yazın (Göndermek için Enter tuşuna basın veya dosya/görsel sürükleyin)"/>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Small Sleek Live Mic Icon Button -->
                                <Button x:Name="BtnMicLive" Click="BtnMicLive_Click" Width="36" Height="32" Padding="0" Margin="0,0,8,0"
                                        Background="#2C2C2E" BorderBrush="#3A3A3C" BorderThickness="1"
                                        ToolTip="Canlı Sesli Sohbet (Faster-Whisper &amp; Edge-TTS) - Aç/Kapat"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock x:Name="IconMicSymbol" Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <!-- Minimal Live Indicator Badge -->
                                <StackPanel x:Name="PnlLiveIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <Ellipse x:Name="LiveStatusDot" Width="8" Height="8" Fill="#FF453A" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtLiveQuickStatus" Text="Dinliyor..." Foreground="#0A84FF" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Enter: Gönder • Shift+Enter: Yeni Satır" Foreground="{StaticResource TextMuted}" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnClearChat" Content="Temizle" Click="BtnClearChat_Click" Margin="0,0,8,0" Padding="14,6" FontSize="11"/>
                                <Button x:Name="BtnStopGeneration" Style="{StaticResource AppleDangerButton}" Content="⏹️ Durdur" Click="BtnStopGeneration_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6" FontSize="11" ToolTip="Cevap akışını veya sesli okumayı anında durdur"/>
                                <Button x:Name="BtnSend" Style="{StaticResource ApplePrimaryButton}" Content="Gönder" Click="BtnSend_Click" Padding="20,6" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderSubtle}"/>

            <!-- RIGHT PANE -->
            <Grid Grid.Column="2" Background="{StaticResource BgSurface}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- APPLE SEGMENTED TAB HEADER -->
                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Border HorizontalAlignment="Left" Background="{StaticResource BgWindow}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabBtnGraph" Style="{StaticResource AppleSegmentedRadioButton}" Content="🧠 Bilgi Ağı" IsChecked="True" Checked="TabBtnGraph_Checked"/>
                            <RadioButton x:Name="TabBtnDatabase" Style="{StaticResource AppleSegmentedRadioButton}" Content="🗄️ Veritabanı Gezgini" Checked="TabBtnDatabase_Checked"/>
                            <RadioButton x:Name="TabBtnTools" Style="{StaticResource AppleSegmentedRadioButton}" Content="⚡ AI Araçları &amp; MCP" Checked="TabBtnTools_Checked"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- TAB CONTENTS -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: VISUAL KNOWLEDGE GRAPH -->
                    <Grid x:Name="ViewGraph" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Apple Cohesive Action Toolbar (Zero Color Clown Palette) -->
                        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSeparator}" BorderThickness="0,0,0,1" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Unified Smart Add Source Button with ContextMenu -->
                                <Button x:Name="BtnAddSourceMenu" Style="{StaticResource ApplePrimaryButton}" Content="➕ Kaynak Ekle ▾" Click="BtnAddSourceMenu_Click" Padding="14,6" Margin="0,0,8,0" FontSize="11" ToolTip="Şirketinize masaüstü uygulaması, kurumsal belge veya klasör/proje öğretin">
                                    <Button.ContextMenu>
                                        <ContextMenu Background="#252528" Foreground="#F5F5F7" BorderBrush="#38383A">
                                            <MenuItem Header="⚡ Masaüstü Uygulaması İncele (.exe)" Click="BtnInspectApp_Click" FontSize="11.5" Foreground="#F5F5F7"/>
                                            <MenuItem Header="📄 Kurumsal Belge Yükle (PDF, Word, Excel, Metin)" Click="BtnUploadDocument_Click" FontSize="11.5" Foreground="#F5F5F7"/>
                                            <MenuItem Header="📁 Klasör / Proje Tara (Web Sitesi, Kod veya Doküman)" Click="BtnScanFolder_Click" FontSize="11.5" Foreground="#F5F5F7"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Hidden legacy buttons to preserve internal bindings -->
                                <Button x:Name="BtnInspectApp" Visibility="Collapsed"/>
                                <Button x:Name="BtnUploadDocument" Visibility="Collapsed"/>
                                <Button x:Name="BtnScanFolder" Visibility="Collapsed"/>

                                <Button x:Name="BtnManageKnowledge" Content="📋 Bilgileri Yönet" Click="BtnManageKnowledge_Click" Padding="12,6" Margin="0,0,6,0" FontSize="11" ToolTip="Taranmış belgeleri ve kuralları listeleyin, tek tek veya topluca silin."/>
                                <Button x:Name="BtnRefreshGraph" Content="🔄 Yenile" Click="BtnRefreshGraph_Click" Padding="10,6" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <wv2:WebView2 x:Name="KnowledgeGraphWebView" Grid.Row="1"/>
                    </Grid>

                    <!-- VIEW 2: EMBEDDED DATABASE EXPLORER -->
                    <Grid x:Name="ViewDatabase" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- DB Purpose Explanatory Banner -->
                        <Border Grid.Row="0" Background="#1C1C1E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🗄️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Kurumsal Veritabanı Gezgini &amp; Tersine Mühendislik" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Şirketinizin SQLite veritabanlarını kod yazmadan doğrudan inceleyin, tabloları ve kayıtları listeleyin, Excel'e aktarın veya şemayı tek tıkla AI Bilgi Ağına ekleyin." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Top DB Toolbar -->
                        <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSeparator}" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Veritabanı:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                    <ComboBox x:Name="CmbDbSelector" Width="240" MinHeight="28" SelectionChanged="CmbDbSelector_SelectionChanged"/>
                                    <Button x:Name="BtnOpenExternalDb" Content="📂 DB Aç" Click="BtnOpenExternalDb_Click" Margin="6,0,0,0" Padding="10,5" FontSize="11" ToolTip="Farklı bir SQLite veritabanı dosyası (.db, .sqlite) seçin"/>
                                    <Button x:Name="BtnReverseEngineerDb" Style="{StaticResource ApplePrimaryButton}" Content="⚡ Şemayı Çöz &amp; Bilgi Ağına Ekle" Click="BtnReverseEngineerDb_Click" Margin="6,0,0,0" Padding="12,5" FontSize="11" ToolTip="Veritabanı ilişkilerini analiz et ve Bilgi Ağına kat"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnExecuteDbSql" Style="{StaticResource ApplePrimaryButton}" Content="▶️ SQL Çalıştır" Click="BtnExecuteDbSql_Click" Padding="14,5" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Split DB Explorer Body -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" MinWidth="160"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Tables List -->
                            <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSeparator}" BorderThickness="0,0,1,0" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="📊 Keşfedilen Tablolar" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <ListBox x:Name="LstDbTables" Grid.Row="1" Background="{StaticResource BgWindow}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" SelectionChanged="LstDbTables_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TableName}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1" Background="#2C2C2E" CornerRadius="8" Padding="6,2" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding RowCount, StringFormat='{}{0:N0}'}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderSubtle}"/>

                            <!-- Right Column: Query Box & Results DataGrid -->
                            <Grid Grid.Column="2" Background="{StaticResource BgWindow}" Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- SQL Query Input Box -->
                                <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="SQL Sorgusu (Yalnızca Güvenli SELECT Sorguları):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtDbSqlQuery" Grid.Row="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Background="#141416" Foreground="#30D158" FontFamily="Consolas, Courier New" FontSize="12"
                                                 BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8"
                                                 Text="SELECT * FROM Faturalar LIMIT 50;"/>
                                    </Grid>
                                </Border>

                                <!-- Results DataGrid with Dark Column Header Style -->
                                <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <DataGrid x:Name="GridDbResults" AutoGenerateColumns="True" IsReadOnly="True"
                                              Background="#161618" Foreground="{StaticResource TextPrimary}"
                                              BorderThickness="0" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#2C2C2E" HeadersVisibility="Column"
                                              RowBackground="#1A1A1C" AlternatingRowBackground="#202024"
                                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="Background" Value="#252528"/>
                                                <Setter Property="Foreground" Value="#0A84FF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                                <Setter Property="Padding" Value="10,6"/>
                                                <Setter Property="BorderBrush" Value="#38383A"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="{x:Type DataGridCell}">
                                                <Setter Property="Foreground" Value="#F5F5F7"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                        </DataGrid.CellStyle>
                                    </DataGrid>
                                </Border>

                                <!-- Bottom Status & Export -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtDbQueryStatus" Text="Sorgu çalıştırılmaya hazır." Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnCopyDbResults" Content="📋 Sonuçları Kopyala" Click="BtnCopyDbResults_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11"/>
                                        <Button x:Name="BtnExportDbCsv" Content="💾 CSV / Excel İndir" Click="BtnExportDbCsv_Click" Padding="10,5" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- VIEW 3: AI TOOLS & MCP INTEGRATION -->
                    <Grid x:Name="ViewTools" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Background="{StaticResource BgWindow}" Margin="16">
                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Şirket &amp; Sistem Talimatları" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Şirket Adı:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtEditCompanyName" Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}" Padding="10,6" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtle}"/>

                                        <TextBlock Text="Sektör:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtEditCompanyIndustry" Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}" Padding="10,6" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtle}"/>

                                        <TextBlock Text="Şirkete Özel Sistem Promptu:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtEditCompanyPrompt" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}" Padding="10,6" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtle}"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnSaveCompanySettings" Style="{StaticResource ApplePrimaryButton}" Content="Ayarları Kaydet" Click="BtnSaveCompanySettings_Click" Padding="14,6" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnDeleteActiveCompanyQuick" Style="{StaticResource AppleDangerButton}" Content="🗑️ Bu Şirketi Sil" Click="BtnDeleteActiveCompanyQuick_Click" Padding="14,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Bulut AI / API Key Bağlantı Ayarları (OpenAI, Claude, Bulut AI)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                        <TextBlock Text="OpenAI, Anthropic Claude veya Google API anahtarlarınızı girerek yüksek zekalı bulut modellerini sisteme dahil edebilirsiniz. Anahtarlar yerel makinenizde şifreli olarak saklanır." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnManageApiKeysSettings" Style="{StaticResource ApplePrimaryButton}" Content="🔑 API Key ve Bulut Modellerini Yönet" Click="BtnApiKeySettings_Click" Padding="14,7" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Yapay Zekalar İçin Oluşturulan Araçlar (AI Tools &amp; MCP)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Uygulamanızdan (.exe) otomatik çıkarılan ve yapay zekaların kullanabileceği standart fonksiyonlar:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <Border Background="#161618" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Standart Tool JSON Şeması:" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtToolSchemaViewer" IsReadOnly="True" Height="200"
                                                         Background="#121214" Foreground="#D1D1D6" FontFamily="Consolas, Courier New"
                                                         FontSize="11" Padding="8" BorderThickness="0"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                         AcceptsReturn="True" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnCopyToolSchema" Style="{StaticResource ApplePrimaryButton}" Content="Şemayı Kopyala" Click="BtnCopyToolSchema_Click" Padding="14,6" Margin="0,0,8,0"/>
                                            <Button x:Name="BtnRefreshToolSchema" Content="Yenile" Click="BtnRefreshToolSchema_Click" Padding="12,6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ŞİRKET SİLME (TEHLİKELİ BÖLGE) -->
                                <Border Background="{StaticResource BgCard}" BorderBrush="#4A2222" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🗑️ Şirket Silme (Kalıcı Olarak Temizle)" FontSize="13" FontWeight="SemiBold" Foreground="#FF453A" Margin="0,0,0,4"/>
                                        <TextBlock Text="Kullanılmayan şirket profillerini ve bunlara ait verileri sistemden kalıcı olarak silebilirsiniz:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                        <TextBlock Text="Silinecek Şirket:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbDeleteCompanyList" Grid.Column="0" Height="32"/>
                                            <Button x:Name="BtnDeleteCompany" Style="{StaticResource AppleDangerButton}" Grid.Column="1" Content="🗑️ Şirketi Kalıcı Olarak Sil" Click="BtnDeleteCompany_Click" Margin="8,0,0,0" Padding="14,6"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkDeleteCompanyFiles" Content="Şirkete ait tüm çalışma alanı, taranan belgeler, araçlar ve bilgi ağını diskten kalıcı olarak temizle" Foreground="{StaticResource TextSecondary}" FontSize="11" IsChecked="True" Margin="0,0,0,6"/>
                                        <TextBlock Text="⚠️ Not: Sistemde en az bir şirketin bulunması gereklidir. Son kalan şirket silinemez." Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. APPLE MINIMAL STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtWorkspaceStatus" Text="Çalışma Alanı: Aktif" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOllamaStatus" Text="Ollama Bağlı" FontSize="11" Foreground="#30D158" Margin="0,0,14,0"/>
                    <TextBlock Text="İzole Ortam" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0"/>
                    <TextBlock Text="Alp Studio" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>