<Window x:Class="EnterpriseAIApp.ManageKnowledgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şirket Bilgi &amp; Doküman Yönetimi"
        Icon="Assets/app.ico"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#161618" Foreground="#F5F5F7"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Aptos, sans-serif">
    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#252528"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#38383A"/>
        <SolidColorBrush x:Key="AccentApple" Color="#0A84FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#86868B"/>

        <!-- Apple Standard Button Style -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#242426"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Öğrenilen Bilgi &amp; Belge Listesi" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="TxtManageSubtitle" Text="Aktif Şirket: ... • Eklenen belgeleri ve kavramları buradan yönetebilirsiniz." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LIST CONTAINER -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelKnowledgeItems" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnResetAllKnowledge" Content="Tüm Ağı Sıfırla" Click="BtnResetAllKnowledge_Click" DockPanel.Dock="Left"
                        Background="#252528" Foreground="#FF453A" BorderBrush="{StaticResource BorderSubtle}" Padding="14,7" ToolTip="Tüm eklenen dokümanları siler ve başlangıç durumuna döner."/>
                <Button x:Name="BtnCloseManage" Content="Kapat" Click="BtnCloseManage_Click" DockPanel.Dock="Right" Padding="20,7"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
