<Window x:Class="EnterpriseAIApp.ApiKeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 Bulut AI Servisleri &amp; API Key Ayarları"
        Icon="Assets/app.ico"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#161618" Foreground="#F5F5F7"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Aptos, sans-serif">
    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#252528"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#38383A"/>
        <SolidColorBrush x:Key="AccentApple" Color="#0A84FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#86868B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#30D158"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#242426"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Bulut AI &amp; API Key Ayarları" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Uygulama yerel Ollama modelleriyle %100 çevrimdışı çalışabilir. İsteğe bağlı olarak OpenAI (ChatGPT), Anthropic (Claude) veya Google AI bulut modellerini de kullanmak isterseniz API anahtarlarınızı aşağıdan tanımlayabilirsiniz. Anahtarlar yalnızca kendi cihazınızda güvenle saklanır."
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11.5" LineHeight="16"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. OPENAI CARD -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="🟢" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OpenAI API Key (GPT-4o, GPT-4o Mini, o3-mini)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Ellipse x:Name="DotOpenAiStatus" Width="8" Height="8" Fill="#86868B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOpenAiStatus" Text="Belirtilmedi" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtOpenAiKey" Grid.Column="0" Background="#1C1C1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}" Padding="10,6" FontSize="12"/>
                            <Button x:Name="BtnTestOpenAi" Grid.Column="1" Content="Test Et" Click="BtnTestOpenAi_Click" Margin="8,0,0,0" Padding="12,5" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="Örn: sk-proj-... (https://platform.openai.com/api-keys adresinden alabilirsiniz)" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- 2. ANTHROPIC CLAUDE CARD -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="🟣" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Anthropic Claude API Key (Claude 3.5 Sonnet, Haiku)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Ellipse x:Name="DotClaudeStatus" Width="8" Height="8" Fill="#86868B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtClaudeStatus" Text="Belirtilmedi" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtClaudeKey" Grid.Column="0" Background="#1C1C1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}" Padding="10,6" FontSize="12"/>
                            <Button x:Name="BtnTestClaude" Grid.Column="1" Content="Test Et" Click="BtnTestClaude_Click" Margin="8,0,0,0" Padding="12,5" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="Örn: sk-ant-api03-... (https://console.anthropic.com/settings/keys adresinden alabilirsiniz)" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- 3. GOOGLE AI CARD -->
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="🔵" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Google Cloud AI Key (Flash 3.7, Flash 2.5, Flash Lite)" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Ellipse x:Name="DotGoogleStatus" Width="8" Height="8" Fill="#86868B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtGoogleStatus" Text="Belirtilmedi" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtGoogleKey" Grid.Column="0" Background="#1C1C1E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}" Padding="10,6" FontSize="12"/>
                            <Button x:Name="BtnTestGoogle" Grid.Column="1" Content="Test Et" Click="BtnTestGoogle_Click" Margin="8,0,0,0" Padding="12,5" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="Örn: AIzaSy... (https://aistudio.google.com/app/apikey adresinden alabilirsiniz)" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <TextBlock x:Name="TxtSaveFeedback" Text="" Foreground="{StaticResource SuccessGreen}" FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="İptal" Click="BtnCancel_Click" Margin="0,0,10,0" Padding="16,8"/>
                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryBtn}" Content="💾 Kaydet &amp; Modelleri Güncelle" Click="BtnSave_Click" Padding="18,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
